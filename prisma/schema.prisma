generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  createdAt     DateTime  @default(now())
  emailVerified DateTime?
  image         String?
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?
  accounts      Account[]
  sessions      Session[]

  // relations
  resources        Resource[]        @relation("UserResources")
  uploadedVersions ResourceVersion[] @relation("UserUploadedVersions")
  downloads        Download[]        @relation("UserDownloads")
  
  // marketplace relations
  marketplaceItems MarketplaceItem[] @relation("SellerItems")
  likedItems       MarketplaceLike[] @relation("UserLikes")
  comments         MarketplaceComment[] @relation("UserComments")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resource {
  id           String            @id @default(cuid())
  title        String
  description  String?
  courseId     String?
  uploaderId   String
  uploader     User              @relation("UserResources", fields: [uploaderId], references: [id], onDelete: Cascade)
  currentVerId String?
  versions     ResourceVersion[] @relation("ResourceVersions")
  downloads    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  downloadRecords Download[]     @relation("ResourceDownloads")

  @@index([courseId])
  @@index([uploaderId])
}

model Download {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation("ResourceDownloads", fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation("UserDownloads", fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@index([userId])
}

model ResourceVersion {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation("ResourceVersions", fields: [resourceId], references: [id], onDelete: Cascade)
  filePath   String
  fileName   String
  mimeType   String
  size       Int
  uploaderId String
  uploader   User     @relation("UserUploadedVersions", fields: [uploaderId], references: [id], onDelete: Cascade)
  version    Int
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@index([uploaderId])
}

// Marketplace Models
model MarketplaceItem {
  id            String               @id @default(cuid())
  title         String
  description   String
  price         Float
  originalPrice Float?
  category      String
  condition     String
  sellerId      String
  seller        User                 @relation("SellerItems", fields: [sellerId], references: [id], onDelete: Cascade)
  location      String
  images        String[]             @default([])
  tags          String[]             @default([])
  status        String               @default("active") // active, sold, removed
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  
  likes         MarketplaceLike[]    @relation("ItemLikes")
  comments      MarketplaceComment[] @relation("ItemComments")

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model MarketplaceLike {
  id        String          @id @default(cuid())
  itemId    String
  item      MarketplaceItem @relation("ItemLikes", fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([itemId, userId])
  @@index([itemId])
  @@index([userId])
}

model MarketplaceComment {
  id        String          @id @default(cuid())
  itemId    String
  item      MarketplaceItem @relation("ItemComments", fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("UserComments", fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([itemId])
  @@index([userId])
}